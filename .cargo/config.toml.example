# Bu faylni nusxa olib .cargo/config.toml ga saqlang
# (config.toml .gitignore da — mashinaga xos sozlamalar, repoga tushmasligi kerak)
#
#   cp .cargo/config.toml.example .cargo/config.toml
#
# Keyin o'z platformangizga mos bo'limni oching.

# === Windows (PostgreSQL 17) ===
# [env]
# PQ_LIB_DIR = "C:\\Program Files\\PostgreSQL\\17\\lib"
#
# [target.x86_64-pc-windows-msvc]
# rustflags = ["-L", "C:\\Program Files\\PostgreSQL\\17\\lib"]

# === macOS (Homebrew) ===
# Apple Silicon:
# [env]
# PQ_LIB_DIR = "/opt/homebrew/opt/libpq/lib"
#
# Intel:
# [env]
# PQ_LIB_DIR = "/usr/local/opt/libpq/lib"

# === Linux ===
# Ko'p hollarda libpq avtomatik topiladi (libpq-dev / postgresql-devel).
# Topilmasa:
# [env]
# PQ_LIB_DIR = "/usr/lib/x86_64-linux-gnu"   # Ubuntu/Debian
