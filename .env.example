# ── Identity ──────────────────────────────────────────────────────────────────
# Majburiy. Loyihaning ko'rinadigan nomi — frontend logotipi va brauzer
# sarlavhasi shundan olinadi. Erkin matn: oauth.uz, "OAuth website" va h.k.
# Diqqat: probel bo'lsa qo'shtirnoq SHART — aks holda dotenvy butun faylni
# o'qiy olmaydi va ilova "sozlanmagan" deb ishga tushmaydi.
PROJECT_NAME=My Oauth Website

# Majburiy. Loyihaning kanonik domeni (sxemasiz, portsiz).
# CORS_ORIGIN berilmasa, default `https://$PROJECT_DOMAIN` bo'ladi.
PROJECT_DOMAIN=oauth.example.com

# ── Database ──────────────────────────────────────────────────────────────────
# Majburiy. PostgreSQL ulanish URL i.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/oauth

# ── Ports ─────────────────────────────────────────────────────────────────────
# Ixtiyoriy. Default qiymatlar ko'rsatilgan.
HTTP_PORT=3000

# ── Security ──────────────────────────────────────────────────────────────────
# Majburiy. JWT tokenlarni imzolash uchun maxfiy kalit.
# Kamida 32 belgi, tasodifiy generatsiya tavsiya etiladi:
#   openssl rand -hex 32
JWT_SECRET=your-super-secret-key-change-in-production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Ixtiyoriy. HTTP so'rovlarga ruxsat beriladigan origin.
# Default: https://$PROJECT_DOMAIN
CORS_ORIGIN=http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────────────────
# Ixtiyoriy. Darajalar: error | warn | info | debug | trace
# Modullar bo'yicha: oauth=debug,tower_http=info
RUST_LOG=info

# ── PostgreSQL (Docker Compose uchun) ─────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=oauth
